{
  "rules": {
    ".read": false,
    ".write": false,

    "groupMeta": {
      "$groupId": {
        "ownerId": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid && !$groupId.contains('_')",
          ".validate": "newData.isString()"
        },
        "$other": { ".validate": false }
      }
    },

    "members": {
      "$conversationId": {
        "$uid": {
          ".write": "auth != null && ((newData.val() === true && (($uid !== auth.uid && ($conversationId === auth.uid + '_' + $uid || $conversationId === $uid + '_' + auth.uid)) || ($uid === auth.uid && ($conversationId.beginsWith(auth.uid + '_') || $conversationId.endsWith('_' + auth.uid))))) || root.child('groupMeta').child($conversationId).child('ownerId').val() === auth.uid)",
          ".validate": "newData.val() === true"
        }
      }
    },

    "messages": {
      "$conversationId": {
        ".read": "auth != null && root.child('members').child($conversationId).child(auth.uid).val() === true",

        "$messageId": {
          ".write": "auth != null && !data.exists() && root.child('members').child($conversationId).child(auth.uid).val() === true",
          ".validate": "newData.hasChildren(['senderId', 'text', 'createdAt', 'conversationType', 'target'])",

          "senderId": {
            ".validate": "newData.val() === auth.uid"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000"
          },
          "createdAt": {
            ".validate": "newData.val() === now"
          },
          "conversationType": {
            ".validate": "(newData.val() === 'direct' && $conversationId.contains('_')) || (newData.val() === 'group' && !$conversationId.contains('_'))"
          },
          "target": {
            ".validate": "newData.hasChild('type') && ((newData.child('type').val() === 'conversation' && !newData.hasChild('memberId')) || (newData.child('type').val() === 'member' && newData.hasChild('memberId')))",
            "type": {
              ".validate": "newData.val() === 'conversation' || newData.val() === 'member'"
            },
            "memberId": {
              ".validate": "newData.isString() && root.child('members').child($conversationId).child(newData.val()).val() === true"
            },
            "$other": { ".validate": false }
          },
          "mentionedUserIds": {
            "$index": {
              ".validate": "newData.isString() && root.child('members').child($conversationId).child(newData.val()).val() === true"
            }
          },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
